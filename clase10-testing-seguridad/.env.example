DATABASE_URL=postgresql+psycopg2:/reservas_app:reservas_app@localhost:5432/reservas_db

# Local identity provider (default). Set AUTH_PROVIDER=cognito or AUTH_PROVIDER=azure
# to validate tokens issued by a real AWS Cognito User Pool or Azure AD / Entra ID
# tenant instead of this app's own login endpoint — see docs/security-architecture.md.
AUTH_PROVIDER=local
JWT_SECRET=change-me-in-every-environment-this-is-a-demo-secret
JWT_ISSUER=local-idp
JWT_AUDIENCE=reservas-api
JWT_EXPIRE_MINUTES=30

# Only used when AUTH_PROVIDER=cognito
COGNITO_REGION=
COGNITO_USER_POOL_ID=

# Only used when AUTH_PROVIDER=azure
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# OAuth2 Client Credentials grant (service-to-service, slide 18) — demo values.
OAUTH_CLIENT_ID=reporting-service
OAUTH_CLIENT_SECRET=change-me-too

# Rate limiting (slide 17)
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# PostHog
# Project settings → Project API key, and (your avatar) → Personal API keys.
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
